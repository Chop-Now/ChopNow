# Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/chopnow

# JWT
# Use a strong, unique secret key in real environments. Never commit the real value.
JWT_SECRET=changeme_in_production

# Cloudinary (example keys only; set real values in environment, not in git)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# CORS
# Comma-separated list of allowed frontend origins, e.g. https://app.chopnow.com,https://admin.chopnow.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
