# =============================================================================
# ChopNow Backend – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials
# =============================================================================

# --- Required (app will not start without these) ---

# MongoDB Connection String
# Get from MongoDB Atlas: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chopnow?retryWrites=true&w=majority

# JWT Secret - Generate a strong random string (min 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# --- CORS (required in production) ---
# Comma-separated list of allowed frontend origins. No spaces.
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example:
# ALLOWED_ORIGINS=https://app.chopnow.com,https://www.chopnow.com

# --- Image Uploads (Cloudinary) ---
# Required for avatar/listing/business image uploads
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email Service (SendGrid) ---
# Required for email verification, password reset, OTP, order notifications
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=ChopNow
FRONTEND_URL=http://localhost:5173

# --- Google OAuth ---
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Observability (optional, recommended in production) ---
# Sentry error tracking DSN
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# --- Admin Recovery (optional) ---
# Secret key for emergency maintenance mode recovery
