# =============================================================================
# ChopNow Backend – Environment Variables
# Copy to .env and set values. Never commit .env or real secrets.
# =============================================================================

# --- Required (app will not start without these) ---
MONGO_URI=mongodb://localhost:27017/chopnow
JWT_SECRET=your_secure_random_secret_at_least_32_chars

# --- Server ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# --- CORS (required in production) ---
# Comma-separated list of allowed frontend origins. No spaces.
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example (set exactly your frontend URL(s)):
# ALLOWED_ORIGINS=https://app.chopnow.com,https://www.chopnow.com

# --- Optional: Image uploads (Cloudinary) ---
# Required for avatar/listing/business image uploads. Omit for API-only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email Service (Resend) ---
# Required for email verification, password reset, OTP, order notifications
RESEND_API_KEY=re_your_resend_api_key_here
# Use Resend's default domain for testing (works without verification):
FROM_EMAIL=ChopNow <onboarding@resend.dev>
# After verifying your domain in Resend dashboard, change to:
# FROM_EMAIL=ChopNow <noreply@chopnow.app>
FRONTEND_URL=https://www.chopnow.app

# --- Observability (optional, recommended in production) ---
# Sentry error tracking DSN (leave blank to disable)
SENTRY_DSN=
# Sample rate for performance traces (0.0 - 1.0). Default: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
