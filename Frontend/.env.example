# =============================================================================
# ChopNow Frontend – Environment Variables
# Copy to .env (or set in your hosting dashboard). Used at build time.
# =============================================================================
# API base URL – no trailing slash. All API requests use this.

# Development (backend running locally):
VITE_API_URL=http://localhost:5000

# Production (set to your deployed backend URL):
# VITE_API_URL=https://api.chopnow.com
